# Copy this file to ".env" (same folder) and paste your real key.
# Get a free key at https://aistudio.google.com/apikey
# .env is git-ignored, so the key never reaches GitHub.
GEMINI_API_KEY=paste-your-gemini-key-here
# Optional backup key (best from a different Google project, so it has its own free limit).
# When every model on the first key is used up, Pip moves to this one.
# GEMINI_API_KEY_2=paste-a-backup-key-here
# Optional: share ChirpQuest with phones and laptops on the SAME home Wi-Fi (http://<this computer's address>:5000).
# Off unless this line says 1. Wi-Fi visitors count as visitors: the main password still only works on this computer.
# CHIRPQUEST_WIFI=1
# Optional: email every 💡 "How can we improve?" idea to the ChirpQuest team's Gmail (it's also saved in Manage Accounts).
# The app password is NOT the normal Gmail password: a grown-up makes one at https://myaccount.google.com/apppasswords
# (needs 2-Step Verification). Never paste it into a chat or the code.
# GMAIL_ADDRESS=your-team-address@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# Optional. A parent normally makes the 👪 Manage Accounts password on the website the first time.
# Only add this line if the parent password was forgotten: this one always works too.
# PARENT_PASSWORD=a-new-parent-password
