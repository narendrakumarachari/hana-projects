# Copy this file to ".env" (same folder) and paste your real key.
# Get a free key at https://aistudio.google.com/apikey
# .env is git-ignored, so the key never reaches GitHub.
GEMINI_API_KEY=paste-your-gemini-key-here
# Parents only: the password for 👪 Manage Accounts (delete accounts, reset passwords, daily time limits).
# Pick your own. It can only be set here, never from the website.
PARENT_PASSWORD=pick-a-parent-password
